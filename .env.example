# 复制成 .env 后填写（.env 已在 .gitignore 里，不要提交）
# Windows PowerShell:  Import-Module .\dotenv.psm1 或直接 setx / 系统环境变量里配置
# Ubuntu:              source .env  或写进 systemd 的 EnvironmentFile

# 邮箱 SMTP 密码 / 授权码（QQ、163 需在邮箱设置里开启 SMTP 并生成授权码）
EVE_NEWS_SMTP_PASSWORD=

# 信息搜集与写作所用模型的 API Key（OpenAI / DeepSeek / 通义 / Kimi / 硅基流动 …）
EVE_NEWS_LLM_API_KEY=

# 可选：联网检索供应商密钥（Tavily / Serper）
EVE_NEWS_SEARCH_API_KEY=
